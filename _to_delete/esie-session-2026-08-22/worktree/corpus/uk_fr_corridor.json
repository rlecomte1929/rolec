  "path_classifier_rules": [
    {
      "rule_id": "uk_fr_default_to_lsv",
      "if": {
        "nationality": "GB",
        "destination": "FR",
        "intent": "salaried_employment"
      },
      "then": {
        "pathway": "LONG_STAY_VISA",
        "visa_type": "long_stay_visa"
      },
      "rationale": "Post-Brexit, British nationals are non-EEA; salaried employment in France requires VLS-TS by default. Withdrawal Agreement only protects pre-2021 residents."
    },
    {
      "rule_id": "uk_fr_upgrade_to_passeport_talent",
      "if": {
        "nationality": "GB",
        "destination": "FR",
        "intent": "salaried_employment",
        "qualification": "master_or_equivalent",
        "salary_eur_annual": {
          ">=": 43243
        }
      },
      "then": {
        "pathway": "LONG_STAY_VISA",
        "visa_type": "passeport_talent"
      },
      "rationale": "Qualified employees with salary ≥ €43,243 are eligible for the multi-year Passeport Talent, strongly preferred over annual VLS-TS renewals."
    }
  ],
