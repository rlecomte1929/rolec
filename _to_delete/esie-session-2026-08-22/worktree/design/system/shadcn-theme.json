{
  "_comment": "ReloPass shadcn/ui theme mapping — v1 (C1-11D). Each shadcn CSS variable points at a token from design/system/tokens.css. Component primitives generated by `npx shadcn add <component>` consume these vars automatically. When adding a new shadcn component, run the generator then verify the component's stylesheet references --rp-* tokens (not Tailwind defaults).",
  "_authority": "design/system/tokens.css is the source of truth. This file is a translation layer for shadcn's expected variable names. If a value diverges between the two, tokens.css wins.",

  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "frontend/tailwind.config.js",
    "css": "frontend/src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },

  "cssVars": {
    "light": {
      "_comment": "These names match shadcn/ui's expected CSS variable contract (https://ui.shadcn.com/docs/theming). Each maps via Tailwind's color() utility to a --rp-* token. Tailwind config should declare e.g. `background: 'hsl(var(--background) / <alpha-value>)'` and these vars provide the HSL triplet.",

      "background": "var(--rp-surface)",
      "foreground": "var(--rp-text-primary)",

      "card": "var(--rp-surface)",
      "card-foreground": "var(--rp-text-primary)",

      "popover": "var(--rp-surface)",
      "popover-foreground": "var(--rp-text-primary)",

      "primary": "var(--rp-color-primary-600)",
      "primary-foreground": "var(--rp-text-inverse)",

      "secondary": "var(--rp-color-secondary-500)",
      "secondary-foreground": "var(--rp-text-inverse)",

      "muted": "var(--rp-surface-subtle)",
      "muted-foreground": "var(--rp-text-tertiary)",

      "accent": "var(--rp-color-secondary-50)",
      "accent-foreground": "var(--rp-color-secondary-700)",

      "destructive": "var(--rp-color-danger-500)",
      "destructive-foreground": "var(--rp-text-inverse)",

      "success": "var(--rp-color-success-500)",
      "success-foreground": "var(--rp-text-inverse)",

      "warning": "var(--rp-color-warning-500)",
      "warning-foreground": "var(--rp-color-warning-700)",

      "border": "var(--rp-border-default)",
      "input": "var(--rp-border-default)",
      "ring": "var(--rp-color-primary-500)",

      "radius": "var(--rp-radius-md)"
    }
  },

  "_tailwind_extension_hint": {
    "_comment": "Add this block to frontend/tailwind.config.js theme.extend so utility classes pick up the same tokens.",
    "spacing": {
      "1": "var(--rp-space-1)",
      "2": "var(--rp-space-2)",
      "3": "var(--rp-space-3)",
      "4": "var(--rp-space-4)",
      "6": "var(--rp-space-6)",
      "8": "var(--rp-space-8)",
      "12": "var(--rp-space-12)",
      "16": "var(--rp-space-16)"
    },
    "fontSize": {
      "xs": "var(--rp-text-xs)",
      "sm": "var(--rp-text-sm)",
      "base": "var(--rp-text-base)",
      "md": "var(--rp-text-md)",
      "lg": "var(--rp-text-lg)",
      "xl": "var(--rp-text-xl)",
      "2xl": "var(--rp-text-2xl)",
      "3xl": "var(--rp-text-3xl)"
    },
    "borderRadius": {
      "sm": "var(--rp-radius-sm)",
      "md": "var(--rp-radius-md)",
      "lg": "var(--rp-radius-lg)",
      "xl": "var(--rp-radius-xl)",
      "full": "var(--rp-radius-full)"
    },
    "boxShadow": {
      "sm": "var(--rp-shadow-sm)",
      "md": "var(--rp-shadow-md)",
      "lg": "var(--rp-shadow-lg)",
      "xl": "var(--rp-shadow-xl)",
      "focus": "var(--rp-shadow-focus)"
    },
    "transitionDuration": {
      "fast": "var(--rp-duration-fast)",
      "base": "var(--rp-duration-base)",
      "slow": "var(--rp-duration-slow)"
    },
    "transitionTimingFunction": {
      "out": "var(--rp-easing-out)",
      "in-out": "var(--rp-easing-in-out)",
      "spring": "var(--rp-easing-spring)"
    },
    "zIndex": {
      "tooltip": "var(--rp-z-tooltip)",
      "dropdown": "var(--rp-z-dropdown)",
      "overlay": "var(--rp-z-overlay)",
      "dialog": "var(--rp-z-dialog)",
      "toast": "var(--rp-z-toast)"
    }
  }
}
