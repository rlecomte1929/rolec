  "path_classifier_rules": [
    {
      "rule_id": "br_pt_cplp_preferred_for_brazilian",
      "if": {
        "nationality": "BR",
        "destination": "PT",
        "intent_in": ["salaried_employment", "self_employed", "study", "family"]
      },
      "then": {"pathway": "CPLP_RESIDENCE", "visa_type": "cplp_residence"},
      "rationale": "CPLP is the most flexible and fastest pathway for Brazilian nationals — covers most legitimate intents and benefits from the EU uniform residence-permit model since Law 9/2025."
    },
    {
      "rule_id": "br_pt_d2_for_entrepreneur",
      "if": {
        "nationality": "BR",
        "destination": "PT",
        "intent": "self_employed",
        "prefers_business_plan_route": true
      },
      "then": {"pathway": "LONG_STAY_VISA", "visa_type": "d2_visa"},
      "rationale": "D2 is the established route for entrepreneurs with a formal business plan and investment; useful when CPLP scheduling is congested."
    },
    {
      "rule_id": "br_pt_d7_for_passive_income",
      "if": {
        "nationality": "BR",
        "destination": "PT",
        "intent_in": ["retired", "passive_income"],
        "passive_income_eur_monthly": {">=": 870}
      },
      "then": {"pathway": "LONG_STAY_VISA", "visa_type": "d7_visa"},
      "rationale": "D7 is purpose-built for passive income / retirees. NOTE: D7 does not authorize active employment."
    }
  ],
  "known_gaps": [
    "AIMA backlog is volatile; the post-arrival processing window of 60–150 days reflects 2026 conditions and can shift quickly.",
    "Family reunification (visa C — spouse/children) is out of scope here.",
    "Golden Visa is intentionally not covered — significant policy uncertainty since 2024 reforms; should be a separate corpus with its own freshness cadence.",
    "Tax residency rules and the NHR/IFICI regime are out of scope for the immigration corpus."
  ]
