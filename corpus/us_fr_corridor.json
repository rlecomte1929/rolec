      },
      "then": {"pathway": "LONG_STAY_VISA", "visa_type": "passeport_talent"},
      "rationale": "Qualified employees with salary ≥ €43,243 are eligible for the multi-year Passeport Talent which is strongly preferred over annual VLS-TS renewals."
    }
