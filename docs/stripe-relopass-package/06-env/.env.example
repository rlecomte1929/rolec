# ReloPass — Stripe Integration v1.0
# Copy to .env and fill in real values. NEVER commit the real .env.

# ── Stripe (test mode first — switch to live keys only at go-live) ─────────
# Server-side API key: sk_test_... in test mode, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the webhook endpoint (Developers → Webhooks → endpoint
# → "Signing secret"): whsec_...
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price IDs from the Stripe Dashboard (create the products in TEST mode
# first — build sequence step 4; swap to the live-mode price IDs at step 12).
# Tier 1 — M1 Roadmap + Verified Vendor Shortlist, €800 one-time:
STRIPE_PRICE_ROADMAP_EUR=price_replace_me
# Tier 2 — Essentials (immigration assurance), €2,000 one-time.
# STUB: create the product, but the CTA stays disabled until lawyer sign-off.
STRIPE_PRICE_ESSENTIALS_EUR=price_replace_me

# ── App ────────────────────────────────────────────────────────────────────
# Public origin used to build Stripe success/cancel URLs and email links.
APP_URL=http://localhost:5173
