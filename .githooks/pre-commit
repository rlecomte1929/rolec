#!/usr/bin/env bash
# QG-8 (AIQ-1181): pre-commit gate — run lint-staged (eslint --fix) on STAGED
# frontend TS/TSX, so format/lint errors are caught before the commit instead of
# only in CI. Self-installs via the same core.hooksPath=.githooks mechanism as the
# pre-push hook (frontend/scripts/install-git-hooks.mjs, QG-7).
#
# Gates on eslint ERRORS only (not the ~3451 'warn' backlog the TS/a11y/async epics
# own) — consistent with the CI lint step — so editing a warning-laden file isn't
# blocked. NOTE: deliberately NO `--fix` — `eslint --fix` auto-applies
# no-unnecessary-type-assertion (a warn-level autofixable rule that false-positives)
# and STRIPS necessary `as X` casts during commit, after the local tsc, committing a
# tsc-broken file that only fails in CI (B8 / #951). lint-staged just CHECKS now.
#
# Bypass in genuine emergencies with:  git commit --no-verify

set -euo pipefail

# No-op in CI (the lint already runs there) and in non-interactive automation.
[ -n "${CI:-}" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ── Otto import-batch gate (docs/imports) ────────────────────────────────────────────
# Validate any research batch you are committing against the delivery contract, and keep
# the gate's loader mirror in sync with the deployed loader. Gates only the batches you
# actually staged (legacy batches are left untouched — same "only what changed" shape as
# the CI path filters); fast no-op when nothing relevant is staged.
# Bypass in emergencies with: git commit --no-verify
_staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
_otto_batches="$(printf '%s\n' "$_staged" | awk -F/ '$1=="docs" && $2=="imports" && NF>=3 {print $3}' | sort -u)"
_gate_touched="$(printf '%s\n' "$_staged" | grep -E '^(scripts/check_otto_batches\.py|scripts/check_gate_loader_sync\.py|supabase/functions/otto-loader/index\.ts)$' || true)"
if [ -n "$_otto_batches" ] || [ -n "$_gate_touched" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: ⚠️  python3 not found — skipping the Otto batch gate for this commit."
  else
    if ! python3 scripts/check_gate_loader_sync.py; then
      echo ""
      echo "pre-commit: ❌ gate↔loader allow-list drift — commit aborted."
      echo "            Reconcile scripts/check_otto_batches.py with the loader, or bypass: git commit --no-verify"
      exit 1
    fi
    for _id in $_otto_batches; do
      [ -f "docs/imports/$_id/manifest.json" ] || continue   # skip non-batch dirs
      if ! python3 scripts/check_otto_batches.py "$_id"; then
        echo ""
        echo "pre-commit: ❌ Otto batch '$_id' fails the delivery gate — commit aborted."
        echo "            Fix the batch above, or bypass: git commit --no-verify"
        exit 1
      fi
    done
  fi
fi

# Only relevant when frontend source is staged — skip fast otherwise.
if ! git diff --cached --name-only --diff-filter=ACM | grep -qE '^frontend/src/.*\.(ts|tsx)$'; then
  exit 0
fi

# A fresh clone/worktree may have no node_modules — degrade gracefully (mirrors the
# pre-push guard) instead of hard-erroring with "lint-staged: command not found".
if [ ! -x frontend/node_modules/.bin/lint-staged ]; then
  echo "pre-commit: ⚠️  frontend/node_modules is missing — run 'npm ci' in frontend/ to"
  echo "pre-commit:     enable the staged-lint check. Skipping for this commit."
  exit 0
fi

echo "pre-commit: linting staged frontend files (lint-staged)…"
if ( cd frontend && npx lint-staged ); then
  exit 0
else
  status=$?
  echo ""
  echo "pre-commit: ❌ staged-lint failed — commit aborted."
  echo "            Fix the eslint error(s) above, or bypass with: git commit --no-verify"
  exit "$status"
fi
