#!/usr/bin/env bash
# Pre-push hook: run the frontend production build before allowing a push.
#
# Render auto-deploys `main` on every push, so a broken build on main is a
# user-visible deploy failure. Catching it locally avoids the round-trip.
#
# Activate (one-time, per clone):
#   git config core.hooksPath .githooks
#
# Bypass in genuine emergencies with:
#   git push --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Detect whether this push touches the frontend. Stdin gives us
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines.
need_build=0
touches_workflow=0
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  # Deletion — nothing to build.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  # Determine the commit range being pushed. Resolve it to a real
  # "<base>..<tip>" so `git diff` reports the commits' OWN changes — never a
  # bare single sha, which `git diff` interprets as "tip vs working tree" and
  # at push time (clean tree == tip) yields an empty diff → silent skip. That
  # bug (AIQ-550) let a frontend change ship without a build.
  range=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # Updating an existing remote branch — diff what we're adding on top of it.
    range="$remote_sha..$local_sha"
  elif base=$(git merge-base "$local_sha" origin/main 2>/dev/null); then
    # New branch — diff against where it forked from main.
    range="$base..$local_sha"
  fi

  if [ -z "$range" ]; then
    # Range is undeterminable (new branch and origin/main is unavailable, or the
    # remote sha isn't a local object). We can't tell what's in the push, so
    # build to be safe rather than silently skip.
    echo "pre-push: ⚠️  cannot determine push range — building to be safe (see AIQ-550)."
    need_build=1
    continue
  fi

  changed=$(git diff --name-only "$range" 2>/dev/null || true)
  if printf '%s\n' "$changed" | grep -qE '^frontend/'; then
    need_build=1
  fi
  if printf '%s\n' "$changed" | grep -qE '^\.github/workflows/'; then
    touches_workflow=1
  fi
done

# Heads-up: pushing a workflow-file change needs the GitHub `workflow` token
# scope, which the default OAuth token in some environments lacks. Warn (don't
# block) so the remote rejection is anticipated. See docs/ci/editing-workflows.md.
if [ "$touches_workflow" -eq 1 ]; then
  echo "pre-push: ⚠️  this push edits .github/workflows/* — that needs the GitHub 'workflow' token scope."
  echo "pre-push:     if the push is rejected ('without workflow scope'), run:"
  echo "pre-push:         gh auth refresh -h github.com -s workflow"
  echo "pre-push:     and keep workflow edits in a separate commit from product code."
fi

if [ "$need_build" -eq 0 ]; then
  echo "pre-push: no frontend changes detected — skipping build."
  exit 0
fi

if [ ! -d frontend ]; then
  echo "pre-push: frontend/ not found — skipping."
  exit 0
fi

# QG-7: a fresh clone / worktree has no node_modules, so `npm run build` would
# hard-error with "tsc: command not found" and abort the push. Degrade
# gracefully with a clear instruction instead of blocking.
if [ ! -x frontend/node_modules/.bin/tsc ]; then
  echo "pre-push: ⚠️  frontend/node_modules is missing — run 'npm ci' in frontend/ to"
  echo "pre-push:     enable the pre-push build check. Skipping the build for this push."
  exit 0
fi

echo "pre-push: running frontend production build (npm run build)…"
if ( cd frontend && npm run build ); then
  echo "pre-push: ✅ build passed."
  exit 0
else
  status=$?
  echo ""
  echo "pre-push: ❌ frontend build FAILED — push aborted."
  echo "          Fix the build, or bypass with: git push --no-verify"
  exit "$status"
fi
