# Python
.venv/
venv/
__pycache__/
*.pyc
relopass.db

# Node
# No trailing slash: also ignores a stray `frontend/node_modules` *symlink*
# (a trailing-slash pattern matches directories only, which let one get tracked).
frontend/node_modules
frontend/dist/
# AIQ-1865: the previous rules were path-specific, so a `npm i` run anywhere ELSE
# committed its whole dependency tree. Two did: apps/hr-dashboard/node_modules
# (15,635 files) and design/templates/node_modules (383, a stray `npm i docx` in a
# folder with no package.json). Both are untracked as of this commit. These
# unanchored rules match at ANY depth; scripts/check_no_vendored_deps.py enforces it.
node_modules/
dist/
# Intermediate SSR bundle from scripts/prerender.mjs. Normally deleted by the script;
# survives only when KEEP_PRERENDER_SSR=1 is set to inspect the SSR module graph.
frontend/.prerender-ssr/

# Playwright E2E output (generated by `npm run test:e2e`)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
# Reusable per-role browser sessions for the live-portals suite (QG-AUTH) — these
# hold live login tokens, so they must never be tracked.
frontend/playwright/.auth/

# Lighthouse CI output (generated by `npx lhci autorun`, QG-13)
frontend/.lighthouseci/
frontend/.last-run.json

# Local Claude worktrees — registered via .git/worktrees/, never tracked.
# (A previous commit accidentally committed these as orphan submodule
# gitlinks, which broke Cloudflare Pages clones.)
.claude/worktrees/

# Per-machine Claude Code settings — may record local permission allow-rules
# (e.g. one-off `! TOKEN=… cmd` invocations), so it must never be tracked.
# Keep .claude/settings.json (shared, safe) tracked; only the .local file is ignored.
.claude/settings.local.json

# Agent/tooling scratch — branch snapshots and Playwright MCP run artifacts.
# Machine-generated, regenerated on demand; never useful to track.
.branch-backups/
.playwright-mcp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
.env.local
.env.*

# Allow non-secret env files to be committed
!.env.example
!frontend/.env.production
!frontend/.env.development.example
# The live-portals credential template carries only placeholders (real throwaway
# creds live in the local, gitignored frontend/.env.test).
!frontend/.env.test.example
# frontend/.env.development is intentionally NOT allowlisted — it contains secrets.
# Use frontend/.env.development.example as the template.

# Logs
*.log

# Parker Step E — exported DPO preference datasets (data, not code)
preferences/

# Local audit output
audit_report.json
# Generated PDF fixtures (GAP-011; rebuilt at test time, never committed)
backend/tests/fixtures/generated/

# CI test scratch DBs — created on demand by the backend test harness
# (DATABASE_URL=sqlite:///./ci_test.db). Distinct from the tracked
# `test.db` fixture; never commit.
ci_test.db
ci_test*.db

# Audit/discovery scratch output generated by the multi-phase
# diligence audit and Prompt A ingestion runs. Each is a one-shot
# report that lives on disk for reference but shouldn't ship in the
# repo — it's regenerated when the audit is re-run.
.audit_tmp/
DISCOVERY_REPORT.md
INGESTION_SUMMARY.md

venv_new/
venv/

# Merge / patch cruft. Three-way-merge backups (.orig), reject hunks (.rej),
# and editor lock/temp files. Re-emerge whenever a merge conflict is touched;
# never useful to track.
*.orig
*.rej
.fuse_hidden*
*.ooNMPsk

# Vite dev-server timestamp cache files
frontend/vite.config.ts.timestamp-*

# Runtime / one-shot artifacts — never ship
backend/relopass.db-journal
results/
test_results.json
commit_dest_request.sh
commit_rls0.sh

# Claude Code / Cowork skill bundles — local tooling, not project code
skills/zinzlTfG/

# Cowork / Claude Code skill bundles installed locally
skills/

# FRIDAY-004e local Lighthouse artifacts (not committed)
lighthouse-hero-report*

# SQLite artifacts left behind by local pytest runs (see ci_b2.db, AIQ-1487 review)
ci_*.db
_probe.db
.immigration-fetch-cache.json

# WorkspaceDB snapshot PII. persons / person_identities carry personal data and are
# deliberately NOT committed: keeping them out of history is what preserves the option
# of ever making this repo public, and keeps GDPR erasure scoped to the source database
# rather than to a frozen copy git would retain forever.
# They stay reproducible — MANIFEST.json is committed and carries both URLs and
# sha256s; data/workspace-db-export/<date>/README.md documents the re-fetch.
data/workspace-db-export/*/_pii/
