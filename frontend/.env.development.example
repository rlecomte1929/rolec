# Frontend development environment — copy to `.env.development` and fill in values.
# This file is a template. `.env.development` itself is git-ignored and MUST NOT be committed.

# Backend API URL for local dev. Leave unset to use Vite's `/api` proxy
# (avoids CORS when the app is opened as 127.0.0.1 instead of localhost).
# VITE_API_URL=http://localhost:8000

# Supabase project — get from Supabase dashboard → Settings → API
# Use ONLY the anon/publishable key in the frontend. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics — leave unset to disable. When VITE_POSTHOG_KEY is missing,
# posthog-js is never initialised and no events are sent.
# Get your key from PostHog dashboard → Project Settings → Project API Key.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com  # or https://eu.i.posthog.com for EU cloud

# Feature flags (frontend)
VITE_FEATURE_DYNAMIC_DOSSIER=true
VITE_FEATURE_GUIDANCE_PACK=true
NEXT_PUBLIC_FEATURE_GUIDANCE_PACK=true
# Employee AcroForm auto-fill page (form-fill Phase 1). ON for local dev so the
# /employee/case/:caseId/immigration/forms page + its entry link are testable.
# Prod stays OFF until the official form PDFs are in the form-templates bucket
# (else generate-form 404s per form). See docs/form-autofill/.
VITE_ENABLE_IMMIGRATION_FORMS=true

# Optional dev-only overrides
# VITE_DEMO_MOBILITY_CASE_ID=

# DO NOT commit authenticated session JWTs here. If you need to script against the API
# as a specific user, obtain a fresh token at runtime via Supabase auth.signInWithPassword
# in a local script that is itself git-ignored.
# VITE_SUPABASE_ACCESS_TOKEN=
