# frontend/.env.test — credentials for the LIVE authenticated-portal suite (QG-AUTH).
#
# Copy to `frontend/.env.test` (gitignored) and fill from the Notion page
# "QA Test Credentials" (the same throwaway accounts the weekly relopass-qa-url-verify
# task uses). These are DISPOSABLE, non-PII test users against pre-launch fake data —
# rotate the passwords to force-close access after a QA campaign.
#
# This suite is OPT-IN (`npm run test:e2e:portals`) and excluded from PR CI, so these
# never need to be a GitHub secret unless you wire a scheduled job.

E2E_PORTAL_BASE_URL=https://relopass.com

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=replace-me

E2E_HR_EMAIL=hr@example.com
E2E_HR_PASSWORD=replace-me

E2E_EMPLOYEE_EMAIL=employee@example.com
E2E_EMPLOYEE_PASSWORD=replace-me
