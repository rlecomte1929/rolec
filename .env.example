# Frontend (Vite) — must be prefixed with VITE_
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (FastAPI) — set in your shell or Render env vars
# DATABASE_URL — defaults to sqlite:///./relopass.db if unset
# For Supabase Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./relopass.db

# Policy document uploads (HR Policy page) — required for PDF/DOCX upload and storage
# Supabase Dashboard → your project → Settings → API (or Integrations → API Keys):
#   - Project URL → SUPABASE_URL (e.g. https://xxxxx.supabase.co)
#   - For the Python backend you must use the LEGACY keys: open the tab
#     "Legacy anon, service_role API keys" and copy the "service_role" key (long JWT starting with eyJ...).
#     The new "Secret keys" (sb_secret_...) are not yet supported by supabase-py.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to 1 to skip creating Supabase Auth users on login/register (not recommended in prod)
# DISABLE_SUPABASE_AUTH_SYNC=0

# Postgres only — SQLAlchemy pool (optional; defaults are safe for Supabase)
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=10
# SQLALCHEMY_POOL_RECYCLE=280

# CORS — comma-separated origins (extends built-in defaults)
# Backend already allows localhost:3000–3005 and 5173; add more if needed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002
# Optional override; default regex matches https://relopass.com and https://*.relopass.com
# CORS_ORIGIN_REGEX=^https://([\w-]+\.)*relopass\.com$

# PORT — Render injects this automatically; fallback to 8000 locally
# PORT=8000

# [P4-4] Notification system
# Resend transactional email — get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Sender address (must be a verified domain in your Resend account)
EMAIL_FROM=noreply@relopass.com
# Base URL used in email CTAs
APP_BASE_URL=https://app.relopass.com
# Secret for the daily deadline-reminder cron endpoint (POST /api/crons/deadline-reminder).
# Set the same value in your Supabase pg_cron net.http_post() Authorization header,
# or in your Vercel Cron job's Authorization header.
CRON_SECRET=change_me_to_a_long_random_string

# [SEC-MUT-DRAIN] Shared secret for the internal support-automation endpoints
# (POST /api/support/triage, POST /api/support/reply, PATCH /api/support/ticket/{id}).
# These are invoked by Supabase Edge Function triggers, not end users; the caller
# must send the value in the X-Support-Automation-Secret header.
# Enforcement is fail-open when blank (so local dev works without it) and
# fail-closed once set — ALWAYS set a long random value in production.
SUPPORT_AUTOMATION_SECRET=change_me_to_a_long_random_string

# [P5-8] AI Observability — LangSmith trace logging (optional)
# Sign up at https://smith.langchain.com, create a project, and copy your API key.
# When LANGSMITH_API_KEY is set, every policy assistant session is forwarded as a
# LangSmith run — visible in the project dashboard within ~30 seconds.
# Leave blank to disable (traces still go to policy_assistant_traces DB table + JSON logs).
LANGSMITH_API_KEY=
# Name of the LangSmith project to write traces to.
LANGSMITH_PROJECT=relopass-policy-assistant

# [SEC-001] Debug endpoints — LOCAL DEVELOPMENT ONLY, NEVER set in production.
# The /debug/* diagnostic routes (db connectivity, KV store, Supabase check,
# case-event/assignment inspectors) register ONLY when this is exactly "1".
# Unset (the default) means those routes do not exist and return 404 — which is
# what every production environment must use. Do not set this on Render/prod.
# ENABLE_DEBUG_ENDPOINTS=1

# [P2-08a / AIQ-702] Staleness thresholds — JSON object, in days, per rule tier.
# Used by both backend/app/services/staleness.py and frontend/src/utils/staleness.ts
# so the alert path and the UI badge share one source of truth. Defaults match
# the values below when unset; tiers missing from the JSON fall back per-tier.
# STALENESS_THRESHOLDS_DAYS='{"tier1_critical":30,"tier1_stable":60,"tier2":90}'
# VITE_STALENESS_THRESHOLDS_DAYS='{"tier1_critical":30,"tier1_stable":60,"tier2":90}'

# [P2-08e / AIQ-706] Admin staleness alert threshold — fraction of active cases
# citing a stale source that triggers the ops-notification. Accepts a fraction
# (0.2) or a percentage (20). Defaults to 0.20 when unset.
# STALE_CASE_ALERT_THRESHOLD_PCT=0.20
